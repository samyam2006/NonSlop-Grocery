# =============================================================================
# NonSlop — Whop auth environment variables (set these in Vercel → Settings →
# Environment Variables). Copy to .env for local notes; never commit real values.
# =============================================================================

# --- Required: your Whop OAuth app (Whop dashboard → Developer → OAuth apps) ---
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=

# --- Required: session signing secret. Generate a long random string:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Required: what "having access" means. Set at least one of these to the
#     product/access-pass this guide is sold under. The plan you already have
#     is plan_ar9QvSBZ4fyDG; the access-pass/product id is on the product page
#     in Whop (looks like prod_… / pass_… / acc_…).
WHOP_ACCESS_PASS_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=plan_ar9QvSBZ4fyDG

# --- Strongly recommended: company API key (Whop → Developer → API keys).
#     Lets the server verify a user's membership reliably.
WHOP_API_KEY=

# --- Where to send people ---
CHECKOUT_URL=https://whop.com/checkout/plan_ar9QvSBZ4fyDG
UNPAID_REDIRECT=https://whop.com/checkout/plan_ar9QvSBZ4fyDG
LANDING_URL=/index.html

# --- Optional overrides (defaults shown). Only change if Whop's OAuth docs
#     specify different endpoints/scopes for your app. ---
# WHOP_OAUTH_AUTHORIZE_URL=https://whop.com/oauth
# WHOP_OAUTH_TOKEN_URL=https://api.whop.com/v5/oauth/token
# WHOP_API_BASE=https://api.whop.com
# WHOP_OAUTH_SCOPE=
